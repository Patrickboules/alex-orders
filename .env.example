MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/alex-orders?retryWrites=true&w=majority
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
INSTAPAY_QR_URL=/instapay-qr.png
INSTAPAY_HANDLE=yourname@instapay
# Optional: Vercel Blob for uploaded menu files. Without it, files go to public/uploads/ (dev only).
BLOB_READ_WRITE_TOKEN=
# Optional, for reasoning models such as mistralai/mistral-large-4-1t-a52b: low | medium | high
NVIDIA_REASONING_EFFORT=
# Remote MCP endpoint secret (>= 24 chars): <site>/api/mcp/<MCP_SECRET>. Generate: openssl rand -hex 24
MCP_SECRET=
# Public site URL, used for review links returned by the MCP tools
APP_URL=http://localhost:3000
